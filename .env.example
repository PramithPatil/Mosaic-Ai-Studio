# Gateway and observability credentials are configured server-side only.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_TEXT_MODEL=claude-3-5-sonnet
LITELLM_GUARD_MODEL=llama-guard-3-8b
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional deployment URL for local/self-hosted media services.
COMFYUI_BASE_URL=http://localhost:8188
WHISPER_BASE_URL=
XTTS_BASE_URL=
# Single-workspace starter authentication. Use a strong unique password and generate a
# session secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STUDIO_LOGIN_EMAIL=admin@example.com
STUDIO_LOGIN_PASSWORD=
STUDIO_SESSION_SECRET=
STUDIO_WORKSPACE_ID=northstar

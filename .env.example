# Gateway and observability credentials are configured server-side only.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_TEXT_MODEL=studio-text
LITELLM_GUARD_MODEL=studio-guard
LITELLM_IMAGE_GUARD_MODEL=studio-image-guard
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
# Optional deployment URL for local/self-hosted media services.
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_IMAGE_WORKFLOW_PATH=workflows/image.api.json
COMFYUI_IMAGE_PROMPT_NODE_ID=6
COMFYUI_VIDEO_WORKFLOW_PATH=workflows/video.api.json
COMFYUI_VIDEO_PROMPT_NODE_ID=
COMFYUI_API_KEY=
COMFYUI_TIMEOUT_MS=900000
WHISPER_BASE_URL=http://localhost:8000
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_API_KEY=
XTTS_BASE_URL=http://localhost:8002
XTTS_VOICE=
XTTS_LANGUAGE=en
XTTS_API_KEY=
# Single-workspace starter authentication. Use a strong unique password and generate a
# session secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STUDIO_LOGIN_EMAIL=admin@example.com
STUDIO_LOGIN_PASSWORD=
STUDIO_SESSION_SECRET=
STUDIO_WORKSPACE_ID=northstar
